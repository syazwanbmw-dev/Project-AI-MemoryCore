# perlukan .env dengan API key kalau dipasang nanti. Ditutup SEBELUM key wujud.
# NOTA: .env.example SENGAJA tidak ditapis — ia template tanpa nilai sebenar.

# Environment variables
.env
.env.local
.env.production
.env.test
.env*.local

# Wrangler local secrets (Cloudflare Workers)
.dev.vars
.dev.vars.*

# Google Service Account / Credentials JSON
service-account*.json
credentials*.json
*-key.json
*-credentials.json
client_secret*.json
google-*.json
token.json
secret.json

# Folder secrets
secrets/

# Private keys
*.pem
*.key
*.p12
*.pfx

